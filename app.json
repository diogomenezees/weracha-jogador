{
  "expo": {
    "name": "WeRacha",
    "slug": "weracha-jogador",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "weracha",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.weracha.jogador",
      "associatedDomains": [
        "applinks:weracha.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#161A22",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.weracha.jogador",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "weracha.app",
              "pathPrefix": "/convite"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#161A22",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "O WeRacha usa suas fotos pra você escolher a foto de perfil."
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "O WeRacha salva os replays que você baixa na sua galeria.",
          "granularPermissions": [
            "video"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "332e20fd-a6c9-43ee-b717-a116febc314e"
      }
    },
    "owner": "weracha"
  }
}
